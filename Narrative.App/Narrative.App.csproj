<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>narrative</AssemblyName>
    <RootNamespace>Narrative.App</RootNamespace>
    <Version>0.1.0</Version>
    <Product>Narrative</Product>
    <Description>Collects WhatsApp chat exports and email into one local database, and exports the conversation between people as a single timeline.</Description>
    <Authors>Andrew Johnson</Authors>
    <Copyright>Copyright (c) 2026 Andrew Johnson</Copyright>
    <RepositoryUrl>https://github.com/andyjohnson0/Narrative</RepositoryUrl>
  </PropertyGroup>

  <!-- A Release publish is one self-contained, compressed executable for this machine's platform
       (add -r <rid> for another). Publish only, so builds and tests are unaffected. Not trimmed:
       trimming breaks EF Core, and the trimmed build starts more slowly. -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true' And '$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageReference Include="Scriban" Version="7.5.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.13" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Export\Templates\*.scriban" LogicalName="Narrative.App.Export.Templates.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
